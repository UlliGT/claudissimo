#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(dirname -- "$SCRIPT_DIR")"
LIB_DIR="$REPO_ROOT/lib"

# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [setup|status [projects|agents|service|timer|memory|versions]|update|new|delete|revive|remove|start|info]

Run without an argument for an interactive menu.
EOF
}

run_setup()  { source "$LIB_DIR/setup.sh"; action_setup; }
run_status() { source "$LIB_DIR/status.sh"; action_status "${1:-all}"; }
run_update() { source "$LIB_DIR/update.sh"; action_update; }
run_new()    { source "$LIB_DIR/new_project.sh"; action_new_project; }
run_delete() { source "$LIB_DIR/delete_project.sh"; action_delete_project; }
run_revive() { source "$LIB_DIR/revive.sh"; action_revive; }
run_remove() { source "$LIB_DIR/remove_session.sh"; action_remove_session; }
run_start()  { source "$LIB_DIR/start_session.sh"; action_start_session; }

print_banner() {
  clear
  echo -e "\033[0;37m                                                                                                                                                \033[0m"
  echo -e "\033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀▀▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀\033[0;37m█        \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀▀▀▀▀▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀\033[0;37m█   █\033[0;90;46m▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀▀▀\033[0;37m▄▄    \033[0;90;47m▓\033[0;90;46m▀▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀▀▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀▀▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀\033[0;37m█ \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀\033[0;90m▄▄\033[0;90;46m▀\033[0;90;47m▀▀\033[0;90m▄\033[0;37m   \033[0;90;47m▓\033[0;90;46m▀▀▀▀▀▀▀▀\033[0;37m▄▄   \033[0m"
