  echo -e "\033[0;90;47m▓\033[0;93;43m▒\033[0;93;41m░░\033[0;90m█\033[0;37m▄▄▄▄▄▄▄ \033[0;90;47m▓\033[0;93;41m▒▒▒▒▓\033[0;37m█▄▄▄▄▄▄▄ \033[0;90;47m▓\033[0;93;41m▒▒▒▒\033[0;90m█\033[0;37m   \033[0;90;47m▓\033[0;93;41m▒▒▒▒\033[0;37m█ \033[0;90;47m▓\033[0;93;43m▒░░░\033[0;37;43m▀\033[0;90;43m▀▀▀\033[0;93;43m▒▒▒░\033[0;37m█ \033[0;90;47m▓\033[0;93;43m▒░░░\033[0;37;43m▀\033[0;90;43m▀▀▀\033[0;93;43m▒▒▒░\033[0;37m█ \033[0;90;47m▓\033[0;93;41m▒▒░▒\033[0;37m█ \033[0;90m▄▄▄▄▄▄▄█\033[0;93;41m░\033[0;93;43m▒▒\033[0;90;47m░\033[0;37m \033[0;90m▄▄▄▄▄▄▄█\033[0;93;41m░\033[0;93;43m▒▒\033[0;90;47m░\033[0;37m \033[0;90;47m▓\033[0;93;41m▒▒░▒\033[0;37m█ \033[0;90;47m▓\033[0;93;43m▒░░░\033[0;37m█    \033[0;90;47m▓\033[0;93;43m▒▒\033[0;93;41m▒\033[0;37m█ \033[0;90;47m▓\033[0;93;43m░▒▒▒\033[0;37;43m▀\033[0;90;43m▀▀▀\033[0;93;43m▒▒▒░\033[0;37m█\033[0m"
